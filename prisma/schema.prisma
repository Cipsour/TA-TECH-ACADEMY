// Nexus IT & AI Academy - Database Schema (Prisma ORM)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}

enum LeadSource {
  FORM
  ZALO
  LANDING
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  name          String
  role          Role         @default(STUDENT)
  avatarUrl     String?
  phone         String?
  bio           String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  enrollments   Enrollment[]
  progresses    Progress[]

  @@map("users")
}

model Course {
  id           String       @id @default(uuid())
  title        String
  slug         String       @unique
  description  String
  coverImage   String
  targetAge    String       // e.g. "Primary (6-11)", "Secondary (12-15)", "High School / Uni / Pro"
  price        Float
  originalPrice Float?
  isPublished  Boolean      @default(true)
  category     String       // e.g. "Office Skills", "Programming", "Applied AI"
  duration     String       // e.g. "10 Sessions", "72 Sessions"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  modules      Module[]
  enrollments  Enrollment[]

  @@map("courses")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@map("modules")
}

model Lesson {
  id          String     @id @default(uuid())
  moduleId    String
  title       String
  videoUrl    String?
  content     String     @db.Text
  duration    String?    // e.g. "45 mins"
  order       Int
  createdAt   DateTime   @default(now())

  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses  Progress[]

  @@map("lessons")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Progress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progresses")
}

model Lead {
  id            String     @id @default(uuid())
  name          String
  phone         String
  email         String?
  grade         String?    // Primary, Secondary, Uni, Working
  desiredCourse String
  notes         String?
  source        LeadSource @default(FORM)
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("leads")
}
